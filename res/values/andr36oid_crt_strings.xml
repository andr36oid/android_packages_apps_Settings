<?xml version="1.0" encoding="utf-8"?>
<!-- andr36oid: Settings > Display > CRT effect, dark lines like an old TV drawn by the display hardware -->
<resources>
    <string name="andr36oid_crt_title">CRT effect</string>
    <string name="andr36oid_crt_summary">Experimental: scanlines, a curved screen and glow like an old TV</string>
    <!-- Always at the top of the page -->
    <string name="andr36oid_crt_warning_title">Experimental</string>
    <string name="andr36oid_crt_warning">All effects on this page are experimental. The GPU effects can slow games down dramatically on the RK3326 chip. Some effects may not look right on every screen.</string>
    <string name="andr36oid_crt_intro">The effect covers everything on screen, menus too. Screenshots and screen recordings don\'t show it.</string>

    <string name="andr36oid_crt_enable">Use CRT effect</string>

    <string name="andr36oid_crt_lines_category">Scanlines from the screen hardware</string>
    <string name="andr36oid_crt_lines">Scanlines and mask</string>
    <string name="andr36oid_crt_lines_summary">Drawn by the screen hardware, not the graphics chip</string>

    <string name="andr36oid_crt_style">Style</string>
    <string-array name="andr36oid_crt_style_entries">
        <item>Scanlines</item>
        <item>Scanlines and aperture grille</item>
        <item>Slot mask</item>
        <item>Aperture grille only</item>
    </string-array>
    <!-- persist.andr36oid.crt.style, read by the hardware composer -->
    <string-array name="andr36oid_crt_style_values" translatable="false">
        <item>0</item>
        <item>1</item>
        <item>2</item>
        <item>3</item>
    </string-array>

    <string name="andr36oid_crt_strength">Strength</string>

    <string name="andr36oid_crt_pitch">Line spacing</string>
    <string-array name="andr36oid_crt_pitch_entries">
        <item>Auto, for 240-line games</item>
        <item>Every 2nd row</item>
        <item>Every 3rd row</item>
        <item>Every 4th row</item>
    </string-array>
    <!-- persist.andr36oid.crt.pitch: screen rows per line, 0 = auto -->
    <string-array name="andr36oid_crt_pitch_values" translatable="false">
        <item>0</item>
        <item>2</item>
        <item>3</item>
        <item>4</item>
    </string-array>

    <string name="andr36oid_crt_phase">Move lines down one row</string>
    <string name="andr36oid_crt_phase_summary">Try this if the lines cut through the game\'s pixels unevenly</string>

    <string name="andr36oid_crt_layers_note">Scanlines use one of the screen\'s three hardware layers. With many layers on screen, such as a menu over a video, the graphics chip may have to do more work.</string>

    <string name="andr36oid_crt_gpu_category">Graphics chip effects</string>
    <string name="andr36oid_crt_gpu_note">With any of these above zero, the graphics chip redraws the whole screen every frame. Games can run much slower, especially on a 720x720 screen.</string>
    <!-- Under each graphics chip effect -->
    <string name="andr36oid_crt_gpu_slow">Experimental, can slow games down a lot</string>
    <string name="andr36oid_crt_curvature">Screen curvature</string>
    <string name="andr36oid_crt_glow">Glow</string>
    <string name="andr36oid_crt_gpu_mask">Phosphor mask</string>
    <string name="andr36oid_crt_gpu_mask_summary">Experimental, can slow games down a lot. Red, green and blue stripes; replaces the grille and slot styles above</string>
    <!-- Toast the first time the effect is turned on -->
    <string name="andr36oid_crt_tile_added">CRT effect Quick Tile added to the notification shade</string>
    <!-- Switch-off animation: plays when the screen switches off, persist.andr36oid.crtoff.* -->
    <string name="andr36oid_crtoff_category">Switch-off animation</string>
    <string name="andr36oid_crtoff_note">What the screen does when it switches off. Works without the CRT effect above, and costs nothing while you play.</string>
    <string name="andr36oid_crtoff_style">Animation</string>
    <string-array name="andr36oid_crtoff_style_entries">
        <item>None</item>
        <item>Fade to black</item>
        <item>Old TV</item>
    </string-array>
    <string-array name="andr36oid_crtoff_style_values" translatable="false">
        <item>0</item>
        <item>1</item>
        <item>2</item>
    </string-array>
    <string name="andr36oid_crtoff_length">Length</string>
    <string-array name="andr36oid_crtoff_length_entries">
        <item>Quick (0.4 s)</item>
        <item>Normal (0.7 s)</item>
        <item>Slow (1.2 s)</item>
        <item>Slower (2 s)</item>
        <item>Slow motion (4 s)</item>
    </string-array>
    <string-array name="andr36oid_crtoff_length_values" translatable="false">
        <item>400</item>
        <item>700</item>
        <item>1200</item>
        <item>2000</item>
        <item>4000</item>
    </string-array>
    <string name="andr36oid_crtoff_shape">Shape</string>
    <string-array name="andr36oid_crtoff_shape_entries">
        <item>A line, then a dot</item>
        <item>A line</item>
        <item>Shrinks to a dot</item>
    </string-array>
    <string-array name="andr36oid_crtoff_shape_values" translatable="false">
        <item>0</item>
        <item>1</item>
        <item>2</item>
    </string-array>
    <string name="andr36oid_crtoff_tint">Colour of the line</string>
    <string-array name="andr36oid_crtoff_tint_entries">
        <item>White</item>
        <item>Orange</item>
        <item>Green</item>
        <item>Amber</item>
        <item>Blue</item>
    </string-array>
    <string-array name="andr36oid_crtoff_tint_values" translatable="false">
        <item>0</item>
        <item>1</item>
        <item>2</item>
        <item>3</item>
        <item>4</item>
    </string-array>
    <string name="andr36oid_crtoff_flash">Flash and glow</string>
    <string name="andr36oid_crtoff_afterglow">Afterglow</string>
    <string name="andr36oid_crtoff_backlight">Backlight</string>
    <string name="andr36oid_crtoff_backlight_summary">The backlight flares with the line, flickers with the glitches and dims with the glow</string>
    <string name="andr36oid_crtoff_on_backlight_summary">The backlight thumps and hums while the picture settles</string>
    <string name="andr36oid_crtoff_glitch">Glitches</string>
    <string name="andr36oid_crtoff_glitch_note">The picture losing its signal before it collapses. All at zero gives a clean switch-off.</string>
    <string name="andr36oid_crtoff_tear">Tearing</string>
    <string name="andr36oid_crtoff_tear_summary">Rows of the picture slip sideways</string>
    <string name="andr36oid_crtoff_split">Colour split</string>
    <string name="andr36oid_crtoff_split_summary">Red and blue drift apart at the edges</string>
    <string name="andr36oid_crtoff_noise">Static</string>
    <string name="andr36oid_crtoff_noise_summary">Snow over the picture</string>
    <string name="andr36oid_crtoff_roll">Rolling</string>
    <string name="andr36oid_crtoff_roll_summary">The picture rolls up as it loses hold</string>
    <string name="andr36oid_crtoff_flicker">Flicker</string>
    <string name="andr36oid_crtoff_flicker_summary">The brightness jumps</string>
    <string name="andr36oid_crtoff_on_category">Switch-on animation</string>
    <string-array name="andr36oid_crtoff_on_style_entries">
        <item>None</item>
        <item>Degauss</item>
    </string-array>
    <string-array name="andr36oid_crtoff_on_style_values" translatable="false">
        <item>0</item>
        <item>1</item>
    </string-array>
    <string-array name="andr36oid_crtoff_on_length_entries">
        <item>Quick (0.6 s)</item>
        <item>Normal (1.2 s)</item>
        <item>Slow (2 s)</item>
        <item>Slow motion (4 s)</item>
    </string-array>
    <string-array name="andr36oid_crtoff_on_length_values" translatable="false">
        <item>600</item>
        <item>1200</item>
        <item>2000</item>
        <item>4000</item>
    </string-array>
    <string name="andr36oid_crtoff_on_wobble">Wobble</string>
    <string name="andr36oid_crtoff_on_colour">Rainbow colours</string>
    <string name="andr36oid_crtoff_try">Try it</string>
    <string name="andr36oid_crtoff_try_summary">Switches the screen off now. Press power to switch it back on.</string>
</resources>
