    <string-array name="andr36oid_crt_style_entries">
        <item>Tarama çizgileri</item><item>Tarama çizgileri ve açıklık ızgarası</item><item>Yarık maskesi</item><item>Yalnızca açıklık ızgarası</item>
    </string-array>
    <string name="andr36oid_crt_strength">Yoğunluk</string>
