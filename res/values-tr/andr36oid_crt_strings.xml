<resources>
    <string name="andr36oid_crt_title">CRT efekti</string>
    <string name="andr36oid_crt_summary">Deneysel: eski bir tüplü TV gibi tarama çizgileri, ekran eğriliği ve parıltı</string>
    <string name="andr36oid_crt_warning_title">Deneysel</string>
    <string name="andr36oid_crt_warning">Bu sayfadaki tüm efektler deneyseldir. GPU efektleri, RK3326 çipinde oyunları ciddi ölçüde yavaşlatabilir. Bazı efektler her ekranda düzgün görünmeyebilir.</string>
    <string name="andr36oid_crt_intro">Efekt, menüler dahil tüm ekranı kaplar. Ekran görüntülerinde ve ekran kayıtlarında görünmez.</string>
    <string name="andr36oid_crt_enable">CRT efektini kullan</string>
    <string name="andr36oid_crt_lines_category">Donanımsal tarama çizgileri</string>
    <string name="andr36oid_crt_lines">Tarama çizgileri ve maske</string>
    <string name="andr36oid_crt_lines_summary">Grafik çipi yerine ekran donanımı tarafından çizilir</string>
