    <string name="andr36oid_panel_overclock_preview_missing">此系统暂时无法预览刷新率</string>
    <string name="andr36oid_panel_overclock_preview_failed">预览未能开始</string>

    <string name="andr36oid_panel_overclock_test">流畅度测试</string>
    <string name="andr36oid_panel_overclock_test_summary">一个移动的方块，以及屏幕实际达到的帧率</string>
