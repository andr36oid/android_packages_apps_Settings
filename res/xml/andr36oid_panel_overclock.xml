<!-- Display > Panel overclocking, filled in by PanelOverclockFragment. The text rows are
     selectable (a press does nothing) so the d-pad can move through the page and scroll it -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/andr36oid_panel_overclock_title">

    <Preference
        android:key="intro"
        android:summary="@string/andr36oid_panel_overclock_intro" />

    <Preference
        android:key="warning"
        android:icon="@drawable/ic_warning_24dp"
        android:summary="@string/andr36oid_panel_overclock_warning_line" />

    <Preference
        android:key="screen"
        android:title="@string/andr36oid_panel_overclock_screen_title" />

    <PreferenceCategory
        android:key="rates"
        android:title="@string/andr36oid_panel_overclock_rates" />

    <Preference
        android:key="add"
        android:title="@string/andr36oid_panel_overclock_add"
        android:summary="@string/andr36oid_panel_overclock_add_summary" />

    <Preference
        android:key="restart" />

    <Preference
        android:key="remove_all"
        android:title="@string/andr36oid_panel_overclock_remove_all"
        android:summary="@string/andr36oid_panel_overclock_remove_all_summary" />

    <Preference
        android:key="test"
        android:title="@string/andr36oid_panel_overclock_test"
        android:summary="@string/andr36oid_panel_overclock_test_summary" />
</PreferenceScreen>
