<!-- Display > CRT effect, run by CrtEffectFragment. Nothing is saved here: every row writes
     a persist.andr36oid.crt.* property. The hardware composer reads the line settings each
     frame, SurfaceFlinger the GPU ones. Sliders move with left and right on the d-pad and
     the screen changes at once. The text rows are selectable (a press does nothing) so the
     d-pad can scroll the page. -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/andr36oid_crt_title">

    <Preference
        android:key="warning"
        android:icon="@drawable/ic_warning_24dp"
        android:title="@string/andr36oid_crt_warning_title"
        android:summary="@string/andr36oid_crt_warning" />

    <Preference
        android:key="intro"
        android:summary="@string/andr36oid_crt_intro" />

    <SwitchPreference
        android:key="enable"
        android:persistent="false"
        android:title="@string/andr36oid_crt_enable" />

    <PreferenceCategory
        android:key="lines_category"
        android:title="@string/andr36oid_crt_lines_category">

        <SwitchPreference
            android:key="lines"
            android:persistent="false"
            android:title="@string/andr36oid_crt_lines"
            android:summary="@string/andr36oid_crt_lines_summary" />

        <ListPreference
            android:key="style"
            android:persistent="false"
            android:title="@string/andr36oid_crt_style"
            android:summary="%s"
            android:entries="@array/andr36oid_crt_style_entries"
            android:entryValues="@array/andr36oid_crt_style_values" />

        <!-- AndroidX needs its own seekbar and value IDs; the Settings theme's
             default slider layout is for com.android.settings.widget.SeekBarPreference. -->
        <SeekBarPreference
            android:key="strength"
            android:layout="@layout/preference_widget_seekbar_material"
            android:persistent="false"
            android:title="@string/andr36oid_crt_strength"
            android:max="100" />

        <ListPreference
            android:key="pitch"
            android:persistent="false"
            android:title="@string/andr36oid_crt_pitch"
            android:summary="%s"
            android:entries="@array/andr36oid_crt_pitch_entries"
            android:entryValues="@array/andr36oid_crt_pitch_values" />

        <SwitchPreference
            android:key="phase"
            android:persistent="false"
            android:title="@string/andr36oid_crt_phase"
            android:summary="@string/andr36oid_crt_phase_summary" />

        <Preference
            android:key="layers_note"
            android:summary="@string/andr36oid_crt_layers_note" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="gpu_category"
        android:title="@string/andr36oid_crt_gpu_category">

        <Preference
            android:key="gpu_note"
            android:summary="@string/andr36oid_crt_gpu_note" />

        <SeekBarPreference
            android:key="curvature"
            android:layout="@layout/preference_widget_seekbar_material"
            android:persistent="false"
            android:title="@string/andr36oid_crt_curvature"
            android:summary="@string/andr36oid_crt_gpu_slow"
            android:max="100" />

        <SeekBarPreference
            android:key="glow"
            android:layout="@layout/preference_widget_seekbar_material"
            android:persistent="false"
            android:title="@string/andr36oid_crt_glow"
            android:summary="@string/andr36oid_crt_gpu_slow"
            android:max="100" />

        <SeekBarPreference
            android:key="gpu_mask"
            android:layout="@layout/preference_widget_seekbar_material"
            android:persistent="false"
            android:title="@string/andr36oid_crt_gpu_mask"
            android:summary="@string/andr36oid_crt_gpu_mask_summary"
            android:max="100" />
    </PreferenceCategory>

    <!-- Plays when the screen switches off; on its own, not tied to Use CRT effect -->
    <PreferenceCategory
        android:key="off_category"
        android:title="@string/andr36oid_crtoff_category">

        <Preference
            android:key="off_note"
            android:summary="@string/andr36oid_crtoff_note" />

        <ListPreference
            android:key="off_style"
            android:persistent="false"
            android:title="@string/andr36oid_crtoff_style"
            android:summary="%s"
            android:entries="@array/andr36oid_crtoff_style_entries"
            android:entryValues="@array/andr36oid_crtoff_style_values" />

        <ListPreference
            android:key="off_length"
            android:persistent="false"
            android:title="@string/andr36oid_crtoff_length"
            android:summary="%s"
            android:entries="@array/andr36oid_crtoff_length_entries"
            android:entryValues="@array/andr36oid_crtoff_length_values" />

        <ListPreference
            android:key="off_shape"
            android:persistent="false"
            android:title="@string/andr36oid_crtoff_shape"
            android:summary="%s"
            android:entries="@array/andr36oid_crtoff_shape_entries"
            android:entryValues="@array/andr36oid_crtoff_shape_values" />

        <ListPreference
            android:key="off_tint"
            android:persistent="false"
            android:title="@string/andr36oid_crtoff_tint"
            android:summary="%s"
            android:entries="@array/andr36oid_crtoff_tint_entries"
            android:entryValues="@array/andr36oid_crtoff_tint_values" />

        <SeekBarPreference
            android:key="off_flash"
            android:layout="@layout/preference_widget_seekbar_material"
            android:persistent="false"
            android:title="@string/andr36oid_crtoff_flash"
            android:max="100" />

        <SeekBarPreference
            android:key="off_afterglow"
            android:layout="@layout/preference_widget_seekbar_material"
            android:persistent="false"
            android:title="@string/andr36oid_crtoff_afterglow"
            android:max="100" />

        <Preference
            android:key="off_glitch_note"
            android:title="@string/andr36oid_crtoff_glitch"
            android:summary="@string/andr36oid_crtoff_glitch_note" />

        <SeekBarPreference
            android:key="off_tear"
            android:layout="@layout/preference_widget_seekbar_material"
            android:persistent="false"
            android:title="@string/andr36oid_crtoff_tear"
            android:summary="@string/andr36oid_crtoff_tear_summary"
            android:max="100" />

        <SeekBarPreference
            android:key="off_split"
            android:layout="@layout/preference_widget_seekbar_material"
            android:persistent="false"
            android:title="@string/andr36oid_crtoff_split"
            android:summary="@string/andr36oid_crtoff_split_summary"
            android:max="100" />

        <SeekBarPreference
            android:key="off_noise"
            android:layout="@layout/preference_widget_seekbar_material"
            android:persistent="false"
            android:title="@string/andr36oid_crtoff_noise"
            android:summary="@string/andr36oid_crtoff_noise_summary"
            android:max="100" />

        <SeekBarPreference
            android:key="off_roll"
            android:layout="@layout/preference_widget_seekbar_material"
            android:persistent="false"
            android:title="@string/andr36oid_crtoff_roll"
            android:summary="@string/andr36oid_crtoff_roll_summary"
            android:max="100" />

        <SeekBarPreference
            android:key="off_flicker"
            android:layout="@layout/preference_widget_seekbar_material"
            android:persistent="false"
            android:title="@string/andr36oid_crtoff_flicker"
            android:summary="@string/andr36oid_crtoff_flicker_summary"
            android:max="100" />

        <Preference
            android:key="off_try"
            android:title="@string/andr36oid_crtoff_try"
            android:summary="@string/andr36oid_crtoff_try_summary" />
    </PreferenceCategory>
</PreferenceScreen>
