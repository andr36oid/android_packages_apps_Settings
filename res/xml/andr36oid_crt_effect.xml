<!-- Display > CRT effect, run by CrtEffectFragment. Nothing is saved here: every row writes
     a persist.andr36oid.crt.* property that the hardware composer reads each frame. The
     strength slider moves with left and right on the d-pad, and the page shows the change
     at once. The text rows are selectable (a press does nothing) so the d-pad can scroll. -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/andr36oid_crt_title">

    <Preference
        android:key="intro"
        android:summary="@string/andr36oid_crt_intro" />

    <SwitchPreference
        android:key="enable"
        android:persistent="false"
        android:title="@string/andr36oid_crt_enable" />

    <ListPreference
        android:key="style"
        android:persistent="false"
        android:title="@string/andr36oid_crt_style"
        android:summary="%s"
        android:entries="@array/andr36oid_crt_style_entries"
        android:entryValues="@array/andr36oid_crt_style_values" />

    <com.android.settings.widget.SeekBarPreference
        android:key="strength"
        android:persistent="false"
        android:title="@string/andr36oid_crt_strength"
        android:min="10"
        android:max="100" />

    <ListPreference
        android:key="pitch"
        android:persistent="false"
        android:title="@string/andr36oid_crt_pitch"
        android:summary="%s"
        android:entries="@array/andr36oid_crt_pitch_entries"
        android:entryValues="@array/andr36oid_crt_pitch_values" />

    <SwitchPreference
        android:key="phase"
        android:persistent="false"
        android:title="@string/andr36oid_crt_phase"
        android:summary="@string/andr36oid_crt_phase_summary" />

    <Preference
        android:key="layers_note"
        android:summary="@string/andr36oid_crt_layers_note" />
</PreferenceScreen>
