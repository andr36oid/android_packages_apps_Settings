<!-- About console > Console details: every row uses the same controller, the key says what
     it shows; rows the console can't fill are hidden -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/andr36oid_console_details_title">

    <Preference
        android:key="console_details_console"
        android:title="@string/andr36oid_console_details_console"
        android:summary="@string/summary_placeholder"
        android:selectable="false"
        settings:enableCopying="true"
        settings:controller="com.android.settings.deviceinfo.consoledetails.ConsoleDetailPreferenceController"/>

    <Preference
        android:key="console_details_board"
        android:title="@string/andr36oid_console_details_board"
