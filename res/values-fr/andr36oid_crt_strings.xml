    <string name="andr36oid_crtoff_roll_summary">L’image remonte en défilant quand elle perd le signal</string>
    <string name="andr36oid_crtoff_flicker">Scintillement</string>
    <string name="andr36oid_crtoff_flicker_summary">La luminosité saute</string>
    <string name="andr36oid_crtoff_try">Essayer</string>
    <string name="andr36oid_crtoff_try_summary">Éteint l’écran maintenant. Appuie sur le bouton marche/arrêt pour le rallumer.</string>
    <string name="andr36oid_crtoff_on_category">Animation d’allumage</string>
