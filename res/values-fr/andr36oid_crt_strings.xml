    <string-array name="andr36oid_crtoff_length_entries">
        <item>Rapide (0,4 s)</item>
        <item>Normale (0,7 s)</item>
        <item>Lente (1,2 s)</item>
        <item>Plus lente (2 s)</item>
        <item>Ralenti (4 s)</item>
    </string-array>
    <string name="andr36oid_crtoff_shape">Forme</string>
    <string-array name="andr36oid_crtoff_shape_entries">
