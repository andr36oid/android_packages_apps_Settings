    <string name="andr36oid_crtoff_glitch">Parasites</string>
    <string name="andr36oid_crtoff_glitch_note">L’image perd le signal avant de s’effondrer. Tout à zéro donne une extinction nette.</string>
    <string name="andr36oid_crtoff_tear">Déchirement</string>
    <string name="andr36oid_crtoff_tear_summary">Des lignes de l’image glissent sur le côté</string>
    <string name="andr36oid_crtoff_split">Décalage des couleurs</string>
    <string name="andr36oid_crtoff_split_summary">Le rouge et le bleu s’écartent sur les bords</string>
    <string name="andr36oid_crtoff_noise">Neige</string>
