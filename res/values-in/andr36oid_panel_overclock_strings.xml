    <string name="andr36oid_panel_overclock_restart_remove">Mulai ulang untuk menghapusnya</string>
    <string name="andr36oid_panel_overclock_restart_nothing">Laju sama seperti yang tersimpan</string>
    <string name="andr36oid_panel_overclock_restart_question">Mulai ulang sekarang?</string>
    <!-- %1$s: andr36oid_panel_overclock_warning_line -->
    <string name="andr36oid_panel_overclock_restart_message">Konsol akan mulai ulang dengan laju baru. Lalu pilih salah satu di Peak refresh rate. Jika layar menjadi gelap atau kacau, tunggu 15 detik.\n\n%1$s</string>
