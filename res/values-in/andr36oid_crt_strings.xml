    <string name="andr36oid_crt_phase_summary">Coba jika garis memotong piksel game secara tidak merata</string>
    <string name="andr36oid_crt_layers_note">Garis pindai memakai satu dari tiga lapisan perangkat keras layar. Jika banyak lapisan tampil bersamaan, seperti menu di atas video, chip grafis mungkin harus bekerja lebih keras.</string>
    <string name="andr36oid_crt_gpu_category">Efek chip grafis</string>
    <string name="andr36oid_crt_gpu_note">Jika salah satu nilai ini di atas nol, chip grafis menggambar ulang seluruh layar pada setiap frame. Game bisa berjalan jauh lebih lambat, terutama pada layar 720x720.</string>
    <string name="andr36oid_crt_gpu_slow">Eksperimental, dapat membuat game jauh lebih lambat</string>
    <string name="andr36oid_crt_curvature">Kelengkungan layar</string>
